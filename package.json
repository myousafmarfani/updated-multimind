{
  "name": "llm-vibecoding",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace web",
    "dev:gemini": "python -m uvicorn main:app --reload --port 8001 --app-dir services/gemini-service",
    "dev:chatgpt": "python -m uvicorn main:app --reload --port 8002 --app-dir services/chatgpt-service",
    "dev:claude": "python -m uvicorn main:app --reload --port 8003 --app-dir services/claude-service",
    "dev:grok": "python -m uvicorn main:app --reload --port 8004 --app-dir services/grok-service",
    "build": "npm run build --workspace web",
    "lint": "npm run lint --workspace web",
    "test": "npm run test --workspace web",
    "stop": "node scripts/stop.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "MultiMind monorepo with Next.js web app and Python model services"
}
